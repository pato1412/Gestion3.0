# Datos de conexión al SQL Server, usados por sql.ps1.
# Copiar este archivo como conexion.env (NO se versiona) y completarlo.

# Servidor e instancia, como en SSMS: servidor, servidor\instancia o servidor,puerto
SQL_SERVER=servidor\instancia

# Usuario de SQL Server (solo lectura de estructura)
SQL_USER=claude_user
SQL_PASSWORD=

# Nombres reales de las bases. sql.ps1 las llama por alias:
#   -Base Ensemble -> base propia de Luz Azul, donde se desarrollan todos los proyectos
#   -Base Tempo    -> base del ERP viejo (TEMPO_ERP), con productos y configuraciones
SQL_DB_ENSEMBLE=ENSEMBLE
SQL_DB_TEMPO=EMP001

# 1 = confiar en el certificado del servidor (necesario si usa uno autofirmado)
SQL_TRUST_CERT=0
